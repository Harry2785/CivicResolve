# ==============================================================================
# CivicResolve — Environment Variables Configuration
# Architecture: Vercel Serverless (FastAPI) + Neon PostgreSQL + React 19 Frontend
#
# IMPORTANT:
# - Copy this file to .env before starting locally: cp .env.example .env
# - Never commit real secrets or API keys into version control.
# - In Vercel, set these in: Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain from Neon Console (https://console.neon.tech) -> Dashboard -> Connection Details
# Use the pooled connection string (includes -pooler) for serverless environments.
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
# NEVER prefix with VITE_ or expose to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 3. BACKEND RUNTIME & SECURITY
# ------------------------------------------------------------------------------
ENVIRONMENT=production
# Comma-separated list of approved municipal administrator emails
ADMIN_EMAILS=official1@example.gov.in,admin@civicresolve.gov.in

# Optional: Vercel Blob token for external persistent image storage
# (Automatically injected by Vercel if Blob store is attached to project)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vercel Environment Variables)
# ------------------------------------------------------------------------------
# In unified single-project deployment, leave VITE_API_URL empty (same-origin /api).
# In separate frontend deployment, set to your backend Vercel URL:
# VITE_API_URL=https://your-civicresolve-backend.vercel.app

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_id
