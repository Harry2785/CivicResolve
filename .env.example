# ==============================================================================
# CivicResolve Environment Variables
# IMPORTANT:
# - Copy this file to .env before starting the backend: cp .env.example .env
# - DO NOT commit real secrets or API keys into version control.
# - DO NOT expose API keys in frontend code. All Gemini AI calls are handled securely on the backend.
# ==============================================================================

# Google Gemini API Key (Required for AI issue classification, routing, and summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Configurable; defaults to gemini-2.5-flash with automatic fallback)
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODEL=gemini-3.8-flash

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./civicresolve.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
