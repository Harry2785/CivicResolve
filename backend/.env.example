# ==============================================================================
# CivicResolve Backend — Environment Configuration
# Architecture: FastAPI Serverless on Vercel + Neon PostgreSQL
# ==============================================================================

# Database: Neon PostgreSQL connection string
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini AI (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODEL=gemini-3.8-flash

# Environment & Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Administrator Allowlist (Comma-separated)
ADMIN_EMAILS=official1@example.gov.in,admin@civicresolve.gov.in

# Firebase Project Configuration (Backend)
FIREBASE_PROJECT_ID=civicresolve-4f39e
# Optional: Path to service account key file
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Optional: Persistent Object Storage (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
