# CivicResolve Backend Configuration
# Copy to backend/.env or root .env
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODEL=gemini-3.8-flash
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./civicresolve.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Administrator Authentication & Allowlist
# ==============================================================================
# Comma-separated list of pre-approved official municipal administrator emails.
# Only authenticated accounts matching these exact emails (normalized) will be granted Admin access.
# All other accounts receive HTTP 403 Forbidden.
ADMIN_EMAILS=shrihari0877@gmail.com

# Firebase Project Configuration (Backend)
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: Path to Firebase Service Account JSON (kept strictly on server)
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
