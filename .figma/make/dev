#!/usr/bin/env bash
set -euo pipefail

exec bash -c '
  set -uo pipefail

  backend_pid=
  frontend_pid=

  cleanup() {
    trap - EXIT INT TERM
    [[ -z "$backend_pid" ]] || kill "$backend_pid" 2>/dev/null || true
    [[ -z "$frontend_pid" ]] || kill "$frontend_pid" 2>/dev/null || true
    wait 2>/dev/null || true
  }

  trap cleanup EXIT INT TERM

  PORT=8000 .figma/make/venv/bin/python backend/run.py &
  backend_pid=$!

  (cd frontend && npm exec -- vite --port "$PORT" --host 0.0.0.0) &
  frontend_pid=$!

  wait -n "$backend_pid" "$frontend_pid"
'
