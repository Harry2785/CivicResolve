# ==============================================================================
# CivicResolve Frontend - Firebase Web App Configuration
# ==============================================================================
# Copy this file to frontend/.env.local and populate with your Firebase console values:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# SECURITY GUIDELINES:
# 1. These VITE_ variables are client-side public identifiers for your Firebase project.
# 2. NEVER place Firebase Service Account private keys or backend secrets here!
# 3. Keep frontend/.env.local uncommitted (.gitignore automatically excludes it).
# ==============================================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-your_measurement_id
